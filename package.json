{
  "name": "actions-bell",
  "displayName": "Actions Bell",
  "description": "Auto-tracks GitHub Actions after push, plays sound on completion, shows logs and artifacts",
  "version": "0.1.1",
  "publisher": "birabittoh",
  "repository": "https://github.com/birabittoh/actions-bell",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "actions-bell",
          "title": "Actions Bell",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "actions-bell": [
        {
          "icon": "media/icon.svg",
          "id": "actionsBell.status",
          "name": "Workflow Runs",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "actionsBell.setToken",
        "title": "Set GitHub Token",
        "category": "Actions Bell"
      },
      {
        "command": "actionsBell.clearToken",
        "title": "Clear GitHub Token",
        "category": "Actions Bell"
      },
      {
        "command": "actionsBell.refresh",
        "title": "Refresh",
        "category": "Actions Bell",
        "icon": "$(refresh)"
      },
      {
        "command": "actionsBell.openLogs",
        "title": "View Logs",
        "category": "Actions Bell",
        "icon": "$(output)"
      },
      {
        "command": "actionsBell.openArtifacts",
        "title": "View Artifacts",
        "category": "Actions Bell",
        "icon": "$(package)"
      },
      {
        "command": "actionsBell.openInGitHub",
        "title": "Open in GitHub",
        "category": "Actions Bell",
        "icon": "$(link-external)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "actionsBell.status",
        "contents": "A GitHub token is required to track workflow runs.\n\n[$(key) Set GitHub Token](command:actionsBell.setToken)\n\nNeeds a PAT with repo and workflow read scopes.",
        "when": "!actionsBell.tokenSet"
      },
      {
        "view": "actionsBell.status",
        "contents": "Push commits to start tracking workflows.",
        "when": "actionsBell.tokenSet"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "actionsBell.refresh",
          "when": "view == actionsBell.status && actionsBell.tokenSet",
          "group": "navigation"
        },
        {
          "command": "actionsBell.setToken",
          "when": "view == actionsBell.status && !actionsBell.tokenSet",
          "group": "1_config@1"
        },
        {
          "command": "actionsBell.clearToken",
          "when": "view == actionsBell.status && actionsBell.tokenSet",
          "group": "1_config@1"
        }
      ],
      "view/item/context": [
        {
          "command": "actionsBell.openLogs",
          "when": "view == actionsBell.status && viewItem =~ /^(run|job)/",
          "group": "1_actions@1"
        },
        {
          "command": "actionsBell.openArtifacts",
          "when": "view == actionsBell.status && viewItem == run",
          "group": "1_actions@2"
        },
        {
          "command": "actionsBell.openInGitHub",
          "when": "view == actionsBell.status && viewItem =~ /^(run|job)/",
          "group": "2_github@1"
        }
      ]
    },
    "configuration": {
      "title": "Actions Bell",
      "properties": {
        "actionsBell.sound.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound when workflows complete (disabled by default)"
        },
        "actionsBell.sound.successCommand": {
          "type": "string",
          "default": "",
          "description": "Custom shell command to play success sound. Leave empty to use system default."
        },
        "actionsBell.sound.failureCommand": {
          "type": "string",
          "default": "",
          "description": "Custom shell command to play failure sound. Leave empty to use system default."
        },
        "actionsBell.polling.intervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "How often to poll GitHub Actions API (seconds)"
        },
        "actionsBell.polling.backoffAfterMinutes": {
          "type": "number",
          "default": 5,
          "description": "After this many minutes, slow polling to 30s intervals"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node scripts/generate-sounds.js && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}